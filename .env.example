# Structured server workspace. Use an absolute path outside user input folders.
MATERIAL_STUDIO_MCP_WORKSPACE=D:\path\to\Materials-Studio-mcp\workspace

# Runner jobs use the same workspace. The server also falls back to
# MATERIAL_STUDIO_MCP_WORKSPACE when this compatibility variable is omitted.
MATERIAL_STUDIO_WORKSPACE=D:\path\to\Materials-Studio-mcp\workspace

# Optional when auto-detection succeeds. Use the exact local RunMatScript.bat.
MATERIAL_STUDIO_RUNNER=D:\path\to\BIOVIA\Materials Studio 20.1\etc\Scripting\bin\RunMatScript.bat

# Live GUI hot-load transport. "auto" prefers a healthy GUI loop and otherwise
# uses the verified same-window File/Open path. Use "loop" or "dialog" to force one.
MATERIAL_STUDIO_GUI_HOTLOAD_TRANSPORT=auto

# Positive time limits for a queued GUI-loop job and a fresh loop heartbeat.
MATERIAL_STUDIO_GUI_LOOP_TIMEOUT_SECONDS=45
MATERIAL_STUDIO_GUI_LOOP_HEARTBEAT_TTL_SECONDS=10

# Legacy ms_mcp compatibility settings.
MS_WORKSPACE=D:\path\to\Materials-Studio-mcp\workspace
MS_VERSION=2020
MS_SCRIPT_MODE=perl

# Legacy runner variable used only by the ms_mcp compatibility entrypoint.
MS_SCRIPT_RUNNER=D:\path\to\BIOVIA\Materials Studio 20.1\etc\Scripting\bin\RunMatScript.bat
