{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wqeeeeeeee.github.io/ms_mcp/schemas/work_order.schema.json",
  "title": "Semiconductor Precision Work Order Exchange",
  "description": "Validates either an architect-issued Work Order or the structured result receipt returned for that Work Order.",
  "oneOf": [
    {
      "$ref": "#/$defs/workOrder"
    },
    {
      "$ref": "#/$defs/agentResultReceipt"
    }
  ],
  "$defs": {
    "contractVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "gitPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "artifactPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "role": {
      "enum": [
        "reference_data_agent",
        "canonicalization_and_comparator_agent",
        "bulk_and_alloy_agent",
        "surface_and_2d_agent",
        "defect_and_dopant_agent",
        "interface_and_device_stack_agent",
        "calculation_agent",
        "gui_and_ms_adapter_agent",
        "benchmark_and_release_agent"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "validityStateName": {
      "enum": [
        "structure_valid",
        "semiconductor_domain_valid",
        "ms_roundtrip_valid",
        "calculation_evidence_valid",
        "scientifically_verified"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarios",
        "materials",
        "operations"
      ],
      "properties": {
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "referenceAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "allowed_sources",
        "raw_reference_structure_access",
        "hidden_holdout_access",
        "candidate_write_access",
        "coordinate_disclosure_to_modeler",
        "constraints"
      ],
      "properties": {
        "policy": {
          "enum": [
            "none",
            "metadata_only",
            "task_only",
            "reference_builder",
            "evaluation_only"
          ]
        },
        "allowed_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "raw_reference_structure_access": {
          "type": "boolean"
        },
        "hidden_holdout_access": {
          "type": "boolean"
        },
        "candidate_write_access": {
          "type": "boolean"
        },
        "coordinate_disclosure_to_modeler": {
          "const": false
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "enum": [
                  "none",
                  "metadata_only",
                  "task_only"
                ]
              }
            },
            "required": [
              "policy"
            ]
          },
          "then": {
            "properties": {
              "raw_reference_structure_access": {
                "const": false
              },
              "hidden_holdout_access": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "enum": [
                  "reference_builder",
                  "evaluation_only"
                ]
              }
            },
            "required": [
              "policy"
            ]
          },
          "then": {
            "properties": {
              "candidate_write_access": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hidden_holdout_access": {
                "const": true
              }
            },
            "required": [
              "hidden_holdout_access"
            ]
          },
          "then": {
            "properties": {
              "policy": {
                "enum": [
                  "reference_builder",
                  "evaluation_only"
                ]
              }
            }
          }
        }
      ]
    },
    "testRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "category",
        "command",
        "required",
        "environment"
      ],
      "properties": {
        "test_id": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "enum": [
            "unit",
            "contract",
            "protocol_preview",
            "benchmark_blind",
            "benchmark_regression",
            "no_reference_leak",
            "fake_gui",
            "compileall",
            "diff_check",
            "real_ms_20_1",
            "real_castep_small_cell"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "environment": {
          "enum": [
            "ci",
            "local_mock",
            "real_ms",
            "real_castep"
          ]
        }
      }
    },
    "criterionValue": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      ]
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "validity_state",
        "metric",
        "operator",
        "expected",
        "severity",
        "evidence_required",
        "real_environment_required"
      ],
      "properties": {
        "criterion_id": {
          "$ref": "#/$defs/identifier"
        },
        "validity_state": {
          "$ref": "#/$defs/validityStateName"
        },
        "metric": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]*$"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "contains",
            "set_eq",
            "present"
          ]
        },
        "expected": {
          "$ref": "#/$defs/criterionValue"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "hard_failure",
            "warning"
          ]
        },
        "evidence_required": {
          "type": "boolean"
        },
        "real_environment_required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptanceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria",
        "weighted_score_allowed",
        "hard_failures_compensable"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/acceptanceCriterion"
          }
        },
        "weighted_score_allowed": {
          "const": false
        },
        "hard_failures_compensable": {
          "const": false
        }
      }
    },
    "workOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "contract_version",
        "goal_id",
        "work_order_id",
        "role",
        "base_sha",
        "scope",
        "allowed_paths",
        "forbidden_paths",
        "reference_access",
        "required_tests",
        "acceptance",
        "result_receipt_required"
      ],
      "properties": {
        "document_type": {
          "const": "work_order"
        },
        "contract_version": {
          "$ref": "#/$defs/contractVersion"
        },
        "goal_id": {
          "$ref": "#/$defs/identifier"
        },
        "work_order_id": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "base_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "expected_branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]+$"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gitPath"
          }
        },
        "forbidden_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gitPath"
          }
        },
        "reference_access": {
          "$ref": "#/$defs/referenceAccess"
        },
        "required_tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/testRequirement"
          }
        },
        "acceptance": {
          "$ref": "#/$defs/acceptanceContract"
        },
        "result_receipt_required": {
          "const": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "command",
        "required",
        "status",
        "evidence_paths",
        "summary"
      ],
      "properties": {
        "test_id": {
          "$ref": "#/$defs/identifier"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactPath"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "benchmarkSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_id",
        "run_id",
        "status",
        "case_count",
        "passed",
        "passed_with_warnings",
        "failed",
        "not_run",
        "report_paths",
        "notes"
      ],
      "properties": {
        "suite_id": {
          "$ref": "#/$defs/identifier"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "passed_with_warnings": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "not_run": {
          "type": "integer",
          "minimum": 0
        },
        "report_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactPath"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptanceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "severity",
        "status",
        "evidence_paths",
        "notes"
      ],
      "properties": {
        "criterion_id": {
          "$ref": "#/$defs/identifier"
        },
        "severity": {
          "enum": [
            "hard_failure",
            "warning"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "observed": {
          "$ref": "#/$defs/criterionValue"
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactPath"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "referenceIsolationAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "complied",
        "hidden_reference_read",
        "reference_coordinates_disclosed_to_modeler",
        "candidate_modified_by_evaluator",
        "evidence_paths",
        "notes"
      ],
      "properties": {
        "policy": {
          "enum": [
            "none",
            "metadata_only",
            "task_only",
            "reference_builder",
            "evaluation_only"
          ]
        },
        "complied": {
          "type": "boolean"
        },
        "hidden_reference_read": {
          "type": "boolean"
        },
        "reference_coordinates_disclosed_to_modeler": {
          "const": false
        },
        "candidate_modified_by_evaluator": {
          "const": false
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactPath"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "realEnvironmentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "environment",
        "evidence_paths",
        "notes"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "environment": {
          "enum": [
            "real_ms_20_1",
            "real_castep",
            "not_run"
          ]
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactPath"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contractChangeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "reason",
        "breaking"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "breaking": {
          "type": "boolean"
        }
      }
    },
    "agentResultReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "contract_version",
        "goal_id",
        "work_order_id",
        "role",
        "branch",
        "base_sha",
        "head_sha",
        "changed_paths",
        "tests",
        "benchmark_before",
        "benchmark_after",
        "acceptance_results",
        "reference_isolation",
        "real_materials_studio",
        "real_castep",
        "scientific_boundaries",
        "known_gaps",
        "contract_changes_requested",
        "overall_status"
      ],
      "properties": {
        "document_type": {
          "const": "agent_result_receipt"
        },
        "contract_version": {
          "$ref": "#/$defs/contractVersion"
        },
        "goal_id": {
          "$ref": "#/$defs/identifier"
        },
        "work_order_id": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]+$"
        },
        "base_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "head_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "changed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gitPath"
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/testResult"
          }
        },
        "benchmark_before": {
          "$ref": "#/$defs/benchmarkSummary"
        },
        "benchmark_after": {
          "$ref": "#/$defs/benchmarkSummary"
        },
        "acceptance_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/acceptanceResult"
          }
        },
        "reference_isolation": {
          "$ref": "#/$defs/referenceIsolationAttestation"
        },
        "real_materials_studio": {
          "$ref": "#/$defs/realEnvironmentResult"
        },
        "real_castep": {
          "$ref": "#/$defs/realEnvironmentResult"
        },
        "scientific_boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contract_changes_requested": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contractChangeRequest"
          }
        },
        "overall_status": {
          "$ref": "#/$defs/status"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tests": {
                "contains": {
                  "properties": {
                    "required": {
                      "const": true
                    },
                    "status": {
                      "const": "FAIL"
                    }
                  },
                  "required": [
                    "required",
                    "status"
                  ]
                }
              }
            },
            "required": [
              "tests"
            ]
          },
          "then": {
            "properties": {
              "overall_status": {
                "const": "FAIL"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "acceptance_results": {
                "contains": {
                  "properties": {
                    "severity": {
                      "const": "hard_failure"
                    },
                    "status": {
                      "const": "FAIL"
                    }
                  },
                  "required": [
                    "severity",
                    "status"
                  ]
                }
              }
            },
            "required": [
              "acceptance_results"
            ]
          },
          "then": {
            "properties": {
              "overall_status": {
                "const": "FAIL"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference_isolation": {
                "properties": {
                  "complied": {
                    "const": false
                  }
                },
                "required": [
                  "complied"
                ]
              }
            },
            "required": [
              "reference_isolation"
            ]
          },
          "then": {
            "properties": {
              "overall_status": {
                "const": "FAIL"
              }
            }
          }
        }
      ]
    }
  }
}
