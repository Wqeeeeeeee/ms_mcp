{
  "$defs": {
    "CastepTask": {
      "description": "CASTEP tasks supported by the Materials Studio 20.1 renderer.",
      "enum": [
        "Energy",
        "GeometryOptimization",
        "BandStructure",
        "DensityOfStates",
        "ProjectedDensityOfStates",
        "Optics",
        "Phonon",
        "ElasticConstants"
      ],
      "title": "CastepTask",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "CASTEP task settings rendered against the Materials Studio 20.1 API. The compatibility class dispatches property calculations through Energy and uses dedicated GeometryOptimization and ElasticConstants task APIs. kpoint_separation controls the primary SCF grid.",
  "properties": {
    "module": {
      "const": "CASTEP",
      "default": "CASTEP",
      "title": "Module",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/CastepTask",
      "default": "Energy"
    },
    "functional": {
      "default": "PBE",
      "maxLength": 100,
      "minLength": 1,
      "title": "Functional",
      "type": "string"
    },
    "quality": {
      "default": "Medium",
      "maxLength": 100,
      "minLength": 1,
      "title": "Quality",
      "type": "string"
    },
    "cutoff_energy_ev": {
      "anyOf": [
        {
          "maximum": 100000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cutoff Energy Ev"
    },
    "kpoint_separation": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 10,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kpoint Separation"
    },
    "kpoints": {
      "anyOf": [
        {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kpoints"
    },
    "output_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output File"
    }
  },
  "title": "CastepEnergySpec",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
