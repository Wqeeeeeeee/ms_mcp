{
  "$defs": {
    "CastepCellOptimization": {
      "description": "Geometry-optimization cell modes documented by MS 20.1.",
      "enum": [
        "None",
        "Full",
        "Fixed Volume",
        "Fixed Shape"
      ],
      "title": "CastepCellOptimization",
      "type": "string"
    },
    "CastepDipoleCorrection": {
      "description": "Dipole-correction modes documented by Materials Studio 20.1.",
      "enum": [
        "None",
        "Non self-consistent",
        "Self-consistent"
      ],
      "title": "CastepDipoleCorrection",
      "type": "string"
    },
    "CastepOptimizationAlgorithm": {
      "description": "Geometry-optimization algorithms documented by MS 20.1.",
      "enum": [
        "LBFGS",
        "BFGS",
        "Damped MD",
        "TPSD"
      ],
      "title": "CastepOptimizationAlgorithm",
      "type": "string"
    },
    "CastepTask": {
      "description": "CASTEP tasks supported by the Materials Studio 20.1 renderer.",
      "enum": [
        "Energy",
        "GeometryOptimization",
        "BandStructure",
        "DensityOfStates",
        "ProjectedDensityOfStates",
        "Optics",
        "Phonon",
        "ElasticConstants"
      ],
      "title": "CastepTask",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "CASTEP task settings rendered against the Materials Studio 20.1 API.\n\nThe class name is retained for public compatibility. Property calculations\nare dispatched through the Energy task with documented property flags;\ngeometry optimization and elastic constants use their dedicated task APIs.\n``kpoint_separation`` controls the primary SCF grid, not the separate\nproperty-grid setting.",
  "properties": {
    "module": {
      "const": "CASTEP",
      "default": "CASTEP",
      "title": "Module",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/CastepTask",
      "default": "Energy"
    },
    "functional": {
      "default": "PBE",
      "maxLength": 100,
      "minLength": 1,
      "title": "Functional",
      "type": "string"
    },
    "quality": {
      "default": "Medium",
      "maxLength": 100,
      "minLength": 1,
      "title": "Quality",
      "type": "string"
    },
    "cutoff_energy_ev": {
      "anyOf": [
        {
          "maximum": 100000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cutoff Energy Ev"
    },
    "kpoint_separation": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 10,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kpoint Separation"
    },
    "kpoints": {
      "anyOf": [
        {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kpoints"
    },
    "dipole_correction": {
      "anyOf": [
        {
          "$ref": "#/$defs/CastepDipoleCorrection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "max_iterations": {
      "anyOf": [
        {
          "maximum": 1000000,
          "minimum": 3,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Iterations"
    },
    "displacement_convergence_angstrom": {
      "anyOf": [
        {
          "exclusiveMinimum": 1e-08,
          "maximum": 100,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Displacement Convergence Angstrom"
    },
    "energy_convergence_ev_per_atom": {
      "anyOf": [
        {
          "exclusiveMinimum": 1e-09,
          "maximum": 100,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Energy Convergence Ev Per Atom"
    },
    "force_convergence_ev_per_angstrom": {
      "anyOf": [
        {
          "exclusiveMinimum": 1e-07,
          "maximum": 100,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Force Convergence Ev Per Angstrom"
    },
    "cell_optimization": {
      "anyOf": [
        {
          "$ref": "#/$defs/CastepCellOptimization"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "optimization_algorithm": {
      "anyOf": [
        {
          "$ref": "#/$defs/CastepOptimizationAlgorithm"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "output_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output File"
    }
  },
  "title": "CastepEnergySpec",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
