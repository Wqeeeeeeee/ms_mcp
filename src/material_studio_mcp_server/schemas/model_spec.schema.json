  "additionalProperties": false,
  "description": "模型规格。\n\n属性:\n    project_id: 项目 ID\n    revision: 修订版本号\n    software: 软件名称\n    unit_system: 单位系统\n    model_type: 模型类型\n    model: 模型数据\n    simulation: 模拟规格\n    outputs: 输出配置\n    acceptance: 验收标准\n    metadata: 元数据",
  "properties": {
    "acceptance": {
      "$ref": "#/$defs/AcceptanceCriteria"
    },
