        },
        "properties_kpoint_separation": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Properties Kpoint Separation"
        },
        "quality": {
          "default": "Medium",
          "maxLength": 100,
          "minLength": 1,
          "title": "Quality",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/CastepTask",
          "default": "Energy"
        }
