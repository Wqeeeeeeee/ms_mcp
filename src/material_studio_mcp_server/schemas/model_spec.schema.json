          "type": "string"
        },
        "temperature": {
          "const": "K",
          "default": "K",
          "title": "Temperature",
          "type": "string"
        },
        "time": {
          "default": "ps",
          "enum": [
            "fs",
            "ps"
          ],
          "title": "Time",
          "type": "string"
        }
