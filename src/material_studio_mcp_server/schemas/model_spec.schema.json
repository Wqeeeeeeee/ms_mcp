        "band_structure_energy_max_ev": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band Structure Energy Max Ev"
        },
        "band_structure_energy_tolerance_ev": {
          "anyOf": [
            {
              "exclusiveMinimum": 1e-08,
              "maximum": 100,
              "type": "number"
