                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kpoints"
        },
        "max_iterations": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 3,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Iterations"
        },
        "module": {
          "const": "CASTEP",
          "default": "CASTEP",
          "title": "Module",
          "type": "string"
        },
        "optimization_algorithm": {
          "anyOf": [
            {
              "$ref": "#/$defs/CastepOptimizationAlgorithm"
