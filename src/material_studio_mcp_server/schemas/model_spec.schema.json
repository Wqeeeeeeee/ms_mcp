            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band Structure Energy Tolerance Ev"
        },
        "band_structure_extra_bands": {
          "anyOf": [
            {
              "maximum": 999,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band Structure Extra Bands"
        },
        "cell_optimization": {
          "anyOf": [
            {
              "$ref": "#/$defs/CastepCellOptimization"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cutoff_energy_ev": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cutoff Energy Ev"
        },
        "dipole_correction": {
          "anyOf": [
            {
              "$ref": "#/$defs/CastepDipoleCorrection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "displacement_convergence_angstrom": {
          "anyOf": [
            {
              "exclusiveMinimum": 1e-08,
              "maximum": 100,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displacement Convergence Angstrom"
        },
        "dos_energy_max_ev": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dos Energy Max Ev"
        },
        "dos_energy_tolerance_ev": {
          "anyOf": [
            {
              "exclusiveMinimum": 1e-08,
              "maximum": 100,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dos Energy Tolerance Ev"
        },
        "dos_extra_bands": {
          "anyOf": [
            {
              "maximum": 999,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dos Extra Bands"
        },
        "dos_integration_method": {
          "anyOf": [
            {
              "$ref": "#/$defs/CastepDosIntegrationMethod"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dos_smearing_width_ev": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0.005,
              "type": "number"
            },
            {
              "type": "null"
            }
