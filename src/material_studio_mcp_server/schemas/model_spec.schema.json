      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoleculeSpec"
        },
        {
          "$ref": "#/$defs/CrystalSpec"
        },
        {
          "$ref": "#/$defs/ImportedStructureSpec"
        }
      ],
      "title": "Model"
