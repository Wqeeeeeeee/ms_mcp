#!perl
use strict;
use warnings;
use MaterialsScript qw(:all);

# generated by materials-studio-mcp
# Actual API names must be aligned with Materials Studio Copy Script output.

my $input_path = shift @ARGV;
$input_path = "{{ structure_path }}" unless defined $input_path && length $input_path;

my $doc = Documents->Open($input_path);

my $engine = "{{ settings.engine }}";
my $task = "{{ settings.task }}";
my $results;

if ($engine eq "Forcite" && $task eq "GeometryOptimization") {
    # Replace this block with Materials Studio GUI Copy Script output if your
    # installed version exposes different parameter names.
    my $settings = Settings(
        Quality => {{ settings.quality | default("Medium") | perl_literal }}{% for key, value in settings.parameters.items() %},
        {{ key }} => {{ value | perl_literal }}{% endfor %}
    );
    $results = Modules->Forcite->GeometryOptimization->Run($doc, $settings);
} elsif ($engine eq "CASTEP" && $task eq "GeometryOptimization") {
    die "CASTEP GeometryOptimization template is a placeholder. Generate it with Copy Script.";
} elsif ($engine eq "DMol3" && $task eq "GeometryOptimization") {
    die "DMol3 GeometryOptimization template is a placeholder. Generate it with Copy Script.";
} else {
    die "Unsupported engine/task: $engine/$task";
}

$doc->SaveAs("{{ result_path }}");
print "MaterialsScript completed. Result: {{ result_path }}\n";
